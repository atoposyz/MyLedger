<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Financial records stay local until explicit backup/restore is implemented. -->
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>

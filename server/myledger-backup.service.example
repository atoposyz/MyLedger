[Unit]
Description=MyLedger encrypted backup API
After=network.target

[Service]
User=myledger
Group=myledger
WorkingDirectory=/opt/myledger/server
EnvironmentFile=/etc/myledger-backup.env
ExecStart=/usr/bin/python3 /opt/myledger/server/backup_server.py
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myledger-backups

[Install]
WantedBy=multi-user.target
